{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY",
    "PAYLOAD_SECRET",
    "DATABASE_URL",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "GHL_API_TOKEN",
    "GHL_CALENDAR_ID",
    "GHL_LOCATION_ID",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_FROM",
    "SITE_PASSWORD",
    "WALLET_LINK_SECRET",
    "APPLE_TEAM_ID",
    "APPLE_PASS_TYPE_ID",
    "APPLE_WWDR_CERT_BASE64",
    "APPLE_PASS_CERT_BASE64",
    "APPLE_PASS_PRIVATE_KEY_BASE64",
    "APPLE_PASS_PRIVATE_KEY_PASSWORD",
    "GOOGLE_WALLET_ISSUER_ID",
    "GOOGLE_WALLET_CLASS_SUFFIX",
    "GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64",
    "CRON_SECRET",
    "NEXT_PUBLIC_META_PIXEL_ID",
    "META_DATASET_ID",
    "META_CAPI_ACCESS_TOKEN",
    "META_GRAPH_API_VERSION",
    "META_TEST_EVENT_CODE",
    "GHL_META_WEBHOOK_SECRET",
    "GHL_META_FBC_FIELD_ID",
    "GHL_META_FBP_FIELD_ID",
    "GHL_META_SOURCE_URL_FIELD_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
