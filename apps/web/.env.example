# ── Payload CMS ─────────────────────────────────────────────
# Long random string used to sign tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ── Database — Supabase Postgres ────────────────────────────
# Supabase → Project Settings → Database → Connection string → "URI".
# Use the SESSION pooler / direct connection (port 5432) for migrations,
# and append ?sslmode=require.
# Example:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# ── Media storage — Supabase Storage (S3-compatible) ────────
# Supabase → Storage → create a PUBLIC bucket (e.g. "moves-media").
# Then Storage → Settings → S3 Connection for the endpoint + region,
# and create S3 access keys under Storage → Access Keys.
# Leave these blank to store uploads on local disk instead.
S3_BUCKET=
S3_ENDPOINT=https://[ref].supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Booking — GoHighLevel (LeadConnector) API v2 ────────────
# Powers the /book consultation wizard. SERVER ONLY — never expose as
# NEXT_PUBLIC_*. Leave all three blank to run the booking flow in STUB mode
# (realistic mock slots, no CRM writes). Fill all three to go live.
#   GHL → Settings → Private Integrations → create token with scopes:
#     calendars.readonly, calendars/events.readonly,
#     calendars/events.write, contacts.write
GHL_API_TOKEN=
# GHL → Calendars → the calendar's Settings → calendar ID
GHL_CALENDAR_ID=
# GHL → Settings → Business Profile → Location (sub-account) ID
GHL_LOCATION_ID=

# ── Booking SMS — Twilio ────────────────────────────────────
# Sends the customer a confirmation text after they book. SERVER ONLY —
# never expose as NEXT_PUBLIC_* (the auth token controls your whole Twilio
# account). Leave all three blank to run in STUB mode (logs the message, no
# send). Fill all three to send for real.
#   Twilio Console dashboard → Account SID + Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number messages are sent FROM, in E.164 (e.g. +447700900123)
TWILIO_FROM=

# ── Wallet pass links ──────────────────────────────────────
# Random server-only secret used to encrypt the short-lived appointment data
# carried by Wallet download links. PAYLOAD_SECRET is used as a fallback.
WALLET_LINK_SECRET=

# ── Apple Wallet ───────────────────────────────────────────
# Apple Developer → Certificates, Identifiers & Profiles → Pass Type IDs.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.movesuk.consultation
# Base64-encoded PEM files. Keep all certificate material server-only.
APPLE_WWDR_CERT_BASE64=
APPLE_PASS_CERT_BASE64=
APPLE_PASS_PRIVATE_KEY_BASE64=
APPLE_PASS_PRIVATE_KEY_PASSWORD=

# ── Google Wallet ──────────────────────────────────────────
# Google Pay & Wallet Console issuer ID and a base64-encoded service-account
# JSON key whose client email has Developer access to that issuer.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=moves_consultation
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# One-minute Vercel cron authenticates the T-60 Wallet reminder endpoint.
CRON_SECRET=

# ── Meta paid acquisition ─────────────────────────────────
# Browser Pixel/Dataset id. Public by design; it identifies the dataset but
# cannot write arbitrary server events without the private CAPI token.
NEXT_PUBLIC_META_PIXEL_ID=
# Usually the same id as above. Kept separate so server configuration can be
# rotated without changing browser code.
META_DATASET_ID=
# Server-only Conversions API access token. Never prefix NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=
# Optional override; keep aligned with a supported Meta Graph API version.
META_GRAPH_API_VERSION=v24.0
GHL_META_WEBHOOK_SECRET=
GHL_META_FBC_FIELD_ID=
GHL_META_FBP_FIELD_ID=
GHL_META_SOURCE_URL_FIELD_ID=
# Set only while verifying events in Meta Test Events, then remove.
META_TEST_EVENT_CODE=
