# ─────────────────────────────────────────────────────────────
# Moves — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Supabase — create a project at https://supabase.com/dashboard
# Settings → API. Same project serves both web and mobile.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Expo reads EXPO_PUBLIC_* — same two values as above, duplicated
# because each bundler only exposes its own prefix.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_. Never import in apps/mobile.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI — Account → Access Tokens. Used by the MCP server and `supabase` CLI.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Figma — personal access token for the Figma MCP server.
FIGMA_API_KEY=

# ── Database — Neon Postgres ─────────────────────────────────
# Neon console → your project → Connection Details.
# Payload switches from the local SQLite file to Postgres as soon as
# DATABASE_URL is set. Use the POOLED string here (host contains "-pooler").
DATABASE_URL=

# The same database WITHOUT the pooler. Migrations and DDL must not run
# through a connection pooler.
DATABASE_URL_UNPOOLED=

# Signs Payload auth tokens. Any 32+ char random string — generate with:
#   openssl rand -base64 32
# Use a DIFFERENT value per environment. Changing it signs everyone out.
# Never commit the real value; payload.config.ts falls back to a public
# placeholder, so production MUST set this.
PAYLOAD_SECRET=

# ── Media storage (S3-compatible) ────────────────────────────
# Optional. Without S3_BUCKET, uploads go to local disk and do not
# survive a deploy. forcePathStyle is on, so R2/MinIO work as-is.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Launch gate ──────────────────────────────────────────────
# Shared password for the pre-launch wall on the public site.
# Defaults to "Moves" in app/(frontend)/password/actions.ts.
SITE_PASSWORD=

# ── GoHighLevel — consultation booking ───────────────────────
# Used by src/lib/booking/ghl.ts. The booking wizard posts here.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=

# Admin dashboard — local preview password, used ONLY while Supabase is
# unconfigured and NODE_ENV is not production. Once Supabase is wired up this
# fallback disables itself; delete it then.
ADMIN_PREVIEW_EMAIL=admin@moves.co
ADMIN_PREVIEW_PASSWORD=admin1234
