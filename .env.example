# ─────────────────────────────────────────────────────────────
# Moves — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Supabase — create a project at https://supabase.com/dashboard
# Settings → API. Same project serves both web and mobile.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Expo reads EXPO_PUBLIC_* — same two values as above, duplicated
# because each bundler only exposes its own prefix.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_. Never import in apps/mobile.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI — Account → Access Tokens. Used by the MCP server and `supabase` CLI.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Figma — personal access token for the Figma MCP server.
FIGMA_API_KEY=

# Admin dashboard — local preview password, used ONLY while Supabase is
# unconfigured and NODE_ENV is not production. Once Supabase is wired up this
# fallback disables itself; delete it then.
ADMIN_PREVIEW_EMAIL=admin@moves.co
ADMIN_PREVIEW_PASSWORD=admin1234
